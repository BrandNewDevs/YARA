{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AssistantReply",
  "type": "object",
  "properties": {
    "reply": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "maxLength": 400
    },
    "action": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "none"
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "remember"
            },
            "facts": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "minItems": 1,
              "maxItems": 5
            }
          },
          "required": [
            "type",
            "facts"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "propose_task"
            },
            "task": {
              "$ref": "#/$defs/proposedTask"
            }
          },
          "required": [
            "type",
            "task"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "propose_change"
            },
            "taskId": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "task": {
              "$ref": "#/$defs/proposedTask"
            }
          },
          "required": [
            "type",
            "taskId",
            "task"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "propose_removal"
            },
            "taskId": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          },
          "required": [
            "type",
            "taskId"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "show_help"
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": false
        }
      ]
    }
  },
  "required": [
    "reply",
    "action"
  ],
  "additionalProperties": false,
  "$defs": {
    "proposedSchedule": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "daily"
            },
            "times": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
                "minLength": 5,
                "maxLength": 5
              },
              "minItems": 1,
              "uniqueItems": true
            }
          },
          "required": [
            "type",
            "times"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "weekly"
            },
            "times": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
                "minLength": 5,
                "maxLength": 5
              },
              "minItems": 1,
              "uniqueItems": true
            },
            "weekdays": {
              "type": "array",
              "items": {
                "enum": [
                  "mon",
                  "tue",
                  "wed",
                  "thu",
                  "fri",
                  "sat",
                  "sun"
                ]
              },
              "minItems": 1,
              "uniqueItems": true
            }
          },
          "required": [
            "type",
            "times",
            "weekdays"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "once"
            },
            "inMinutes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1440
            }
          },
          "required": [
            "type",
            "inMinutes"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "once"
            },
            "day": {
              "enum": [
                "today",
                "tomorrow",
                "mon",
                "tue",
                "wed",
                "thu",
                "fri",
                "sat",
                "sun"
              ]
            },
            "times": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
                "minLength": 5,
                "maxLength": 5
              },
              "minItems": 1,
              "maxItems": 1
            }
          },
          "required": [
            "type",
            "day",
            "times"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "once"
            },
            "date": {
              "type": "string",
              "format": "date",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
              "minLength": 10,
              "maxLength": 10
            },
            "times": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
                "minLength": 5,
                "maxLength": 5
              },
              "minItems": 1,
              "maxItems": 1
            }
          },
          "required": [
            "type",
            "date",
            "times"
          ],
          "additionalProperties": false
        }
      ]
    },
    "proposedTask": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "routine",
            "appointment"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "details": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "schedule": {
          "$ref": "#/$defs/proposedSchedule"
        }
      },
      "required": [
        "kind",
        "title",
        "schedule"
      ],
      "additionalProperties": false
    }
  }
}
